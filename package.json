{
  "name": "arkon",
  "private": true,
  "version": "1.0.0",
  "description": "ARKON - Sistema Integral de Seguimiento de Acciones de Programas",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @arkon/web dev",
    "dev:api": "pnpm --filter @arkon/api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @arkon/api test && pnpm --filter @arkon/web test",
    "test:e2e": "pnpm --filter @arkon/web test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
