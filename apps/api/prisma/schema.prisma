generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  estatal
  municipal
  contratista
}

enum EstatusObra {
  en_ejecucion_a_tiempo
  en_ejecucion_retraso
  concluida
  en_riesgo
  en_preparacion
  en_revision
  suspendida
  en_adjudicacion
  en_licitacion
  cancelada
  cerrada
}

enum TipoObra {
  pavimentacion_urbana
  infraestructura_educativa
  drenaje_saneamiento
  electrificacion
  agua_potable
  espacios_publicos
  salud
  proteccion_civil
  infraestructura_comercial
  patrimonio_cultural
  puentes_vialidades
  caminos_rurales
  alumbrado_publico
}

enum EstatusAvance {
  pendiente
  en_revision
  validado
  observado
}

enum EstatusEstimacion {
  no_presentada
  presentada
  en_revision_municipal
  observada_municipio
  validada_municipio
  en_revision_estatal
  observada_estado
  autorizada
  pagada
  rechazada
}

enum EstadoDocumento {
  no_cargado
  cargado
  en_revision
  observado
  validado
}

enum CategoriaDocumento {
  administrativa
  tecnica
  ejecucion
  cierre
  programa
}

enum EstatusObservacion {
  abierta
  en_atencion
  atendida
  cerrada
}

model EntidadFederativa {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique
  clave     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  municipios           Municipio[]
  obras                Obra[]
  organismosOperadores OrganismoOperador[]
  solicitudesPrograma  SolicitudPrograma[]

  @@map("entidades_federativas")
}

model Municipio {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @unique
  latitud       Decimal? @db.Decimal(10, 6)
  longitud      Decimal? @db.Decimal(10, 6)
  claveInegi    String?  @map("clave_inegi")
  tipoLocalidad String?  @map("tipo_localidad")
  marginacion   String?
  esZap         Boolean  @default(false) @map("es_zap")
  poblacion     Int?
  entidadId     String?  @map("entidad_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  entidad              EntidadFederativa?  @relation(fields: [entidadId], references: [id])
  users                Usuario[]
  obras                Obra[]
  alertas              Alerta[]
  alertaConfigs        AlertaConfig[]
  organismosOperadores OrganismoOperador[]
  solicitudesPrograma  SolicitudPrograma[]

  @@index([entidadId])
  @@map("municipios")
}

model OrganismoOperador {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  siglas        String?
  tipoOrganismo String   @map("tipo_organismo")
  entidadId     String?  @map("entidad_id") @db.Uuid
  municipioId   String?  @map("municipio_id") @db.Uuid
  rfc           String?
  director      String?
  email         String?
  telefono      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  entidad        EntidadFederativa? @relation(fields: [entidadId], references: [id])
  municipio      Municipio?         @relation(fields: [municipioId], references: [id])
  obras          Obra[]             @relation("ObraOrganismoOperador")
  anexosTecnicos AnexoTecnico[]

  @@index([entidadId])
  @@index([municipioId])
  @@map("organismos_operadores")
}

model AccionPrograma {
  id            String   @id @default(uuid()) @db.Uuid
  programa      String
  componente    String
  subcomponente String
  clave         String   @unique
  descripcion   String
  unidad        String
  tipoLocalidad String   @map("tipo_localidad")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  obras Obra[]

  @@index([programa, componente])
  @@map("acciones_programa")
}

model Contratista {
  id             String   @id @default(uuid()) @db.Uuid
  nombre         String
  rfc            String   @unique
  representante  String
  email          String?
  telefono       String?
  registroPadron String?  @map("registro_padron")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  users Usuario[]
  obras Obra[]

  @@map("contratistas")
}

model Usuario {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  passwordHash   String    @map("password_hash")
  fullName       String    @map("full_name")
  telefono       String?
  rol            Rol
  rolConagua     String?   @map("rol_conagua")
  avatarInitials String    @default("US") @map("avatar_initials")
  isActive       Boolean   @default(true) @map("is_active")
  lastLogin      DateTime? @map("last_login")
  municipioId    String?   @map("municipio_id") @db.Uuid
  contratistaId  String?   @map("contratista_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  municipio     Municipio?     @relation(fields: [municipioId], references: [id])
  contratista   Contratista?   @relation(fields: [contratistaId], references: [id])
  alertaConfigs AlertaConfig[]

  @@index([municipioId])
  @@index([contratistaId])
  @@map("users")
}

model Programa {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String
  nombreCorto String   @map("nombre_corto")
  tipo        String
  dependencia String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("programas")
}

model Obra {
  id                       String       @id @default(uuid()) @db.Uuid
  folio                    String       @unique
  nombre                   String
  localidad                String
  programa                 String
  tipoPrograma             String       @default("federal") @map("tipo_programa")
  dependencia              String
  tipoObra                 TipoObra     @map("tipo_obra")
  descripcion              String?
  poblacionBeneficiada     Int          @default(0) @map("poblacion_beneficiada")
  montoAutorizado          Decimal      @map("monto_autorizado") @db.Decimal(14, 2)
  montoContratado          Decimal      @default(0) @map("monto_contratado") @db.Decimal(14, 2)
  montoEjercido            Decimal      @default(0) @map("monto_ejercido") @db.Decimal(14, 2)
  supervisor               String?
  fechaInicio              String?      @map("fecha_inicio")
  fechaTerminoProgramada   String?      @map("fecha_termino_programada")
  fechaTerminoReal         String?      @map("fecha_termino_real")
  plazoEjecucion           Int          @default(0) @map("plazo_ejecucion")
  avanceFisicoProgramado   Decimal      @default(0) @map("avance_fisico_programado") @db.Decimal(5, 2)
  avanceFisicoReal         Decimal      @default(0) @map("avance_fisico_real") @db.Decimal(5, 2)
  avanceFinanciero         Decimal      @default(0) @map("avance_financiero") @db.Decimal(5, 2)
  estatus                  EstatusObra  @default(en_preparacion)
  riesgo                   String       @default("bajo")
  latitud                  Decimal?     @db.Decimal(10, 6)
  longitud                 Decimal?     @db.Decimal(10, 6)
  evidenciaFotografica     Json         @default("[]") @map("evidencia_fotografica")
  municipioId              String       @map("municipio_id") @db.Uuid
  contratistaId            String?      @map("contratista_id") @db.Uuid
  cua                      String?      @map("cua")
  idSisba                  String?      @map("id_sisba")
  numContrato              String?      @map("num_contrato")
  comprasMxFolio           String?      @map("compras_mx_folio")
  tipoAdjudicacion         String?      @map("tipo_adjudicacion")
  fechaFallo               String?      @map("fecha_fallo")
  tipoLocalidad            String?      @map("tipo_localidad")
  subcomponente            String?
  accionProgramaId         String?      @map("accion_programa_id") @db.Uuid
  coberturaApAntes         Decimal?     @map("cobertura_ap_antes") @db.Decimal(5, 2)
  coberturaApMeta          Decimal?     @map("cobertura_ap_meta") @db.Decimal(5, 2)
  coberturaTarAntes        Decimal?     @map("cobertura_tar_antes") @db.Decimal(5, 2)
  coberturaTarMeta         Decimal?     @map("cobertura_tar_meta") @db.Decimal(5, 2)
  caudalLps                Decimal?     @map("caudal_lps") @db.Decimal(8, 2)
  pobIncorporar            Int?         @map("pob_incorporar")
  pobMejorar               Int?         @map("pob_mejorar")
  pobMujeres               Int?         @map("pob_mujeres")
  pobIndigena              Int?         @map("pob_indigena")
  pobAfromexicano          Int?         @map("pob_afromexicano")
  entidadFederativaId      String?      @map("entidad_federativa_id") @db.Uuid
  organismoOperadorId      String?      @map("organismo_operador_id") @db.Uuid
  anexoTecnicoId           String?      @map("anexo_tecnico_id") @db.Uuid
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  municipio           Municipio           @relation(fields: [municipioId], references: [id])
  contratista         Contratista?        @relation(fields: [contratistaId], references: [id])
  entidadFederativa   EntidadFederativa?  @relation(fields: [entidadFederativaId], references: [id])
  organismoOperador   OrganismoOperador?  @relation("ObraOrganismoOperador", fields: [organismoOperadorId], references: [id])
  accionPrograma      AccionPrograma?     @relation(fields: [accionProgramaId], references: [id])
  anexoTecnico        AnexoTecnico?       @relation(fields: [anexoTecnicoId], references: [id])
  avances             AvanceMensual[]
  estimaciones        Estimacion[]
  documentos          Documento[]
  observaciones       Observacion[]
  alertas             Alerta[]
  alertaConfigs       AlertaConfig[]
  cofinanciamientos   Cofinanciamiento[]
  avancesTrimestrales AvanceTrimestral[]
  solicitudesResultado SolicitudPrograma[] @relation("SolicitudObraResultante")

  @@index([municipioId])
  @@index([contratistaId])
  @@index([estatus])
  @@index([entidadFederativaId])
  @@index([organismoOperadorId])
  @@index([accionProgramaId])
  @@index([anexoTecnicoId])
  @@index([cua])
  @@map("obras")
}

model AlertaConfig {
  id                String   @id @default(uuid()) @db.Uuid
  nombre            String
  descripcion       String?
  activa            Boolean  @default(true)
  tipo              String
  severidad         String   @default("media")
  programaFiltro    String?  @map("programa_filtro")
  municipioId       String?  @map("municipio_id") @db.Uuid
  obraId            String?  @map("obra_id") @db.Uuid
  umbralDias        Int?     @map("umbral_dias")
  umbralPorcentaje  Decimal? @map("umbral_porcentaje") @db.Decimal(5, 2)
  umbralMonto       Decimal? @map("umbral_monto") @db.Decimal(14, 2)
  destinatariosJson Json     @default("[]") @map("destinatarios_json")
  creadoPor         String   @map("creado_por") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  municipio Municipio? @relation(fields: [municipioId], references: [id], onDelete: SetNull)
  obra      Obra?      @relation(fields: [obraId], references: [id], onDelete: SetNull)
  creador   Usuario    @relation(fields: [creadoPor], references: [id])

  @@index([activa])
  @@index([municipioId])
  @@index([obraId])
  @@index([creadoPor])
  @@map("alerta_configs")
}

model AvanceMensual {
  id          String        @id @default(uuid()) @db.Uuid
  periodo     String
  programado  Decimal       @default(0) @db.Decimal(5, 2)
  reportado   Decimal       @default(0) @db.Decimal(5, 2)
  validado    Decimal?      @db.Decimal(5, 2)
  variacion   Decimal       @default(0) @db.Decimal(5, 2)
  estatus     EstatusAvance @default(pendiente)
  actividades String        @default("")
  comentarios String        @default("")
  obraId      String        @map("obra_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("avances_mensuales")
}

model Estimacion {
  id                  String            @id @default(uuid()) @db.Uuid
  numero              Int
  periodo             String
  montoEstimado       Decimal           @map("monto_estimado") @db.Decimal(14, 2)
  montoAcumulado      Decimal           @map("monto_acumulado") @db.Decimal(14, 2)
  porcentajeFinanciero Decimal          @map("porcentaje_financiero") @db.Decimal(5, 2)
  estatus             EstatusEstimacion @default(no_presentada)
  fechaPresentacion   String?           @map("fecha_presentacion")
  fechaRevision       String?           @map("fecha_revision")
  fechaAutorizacion   String?           @map("fecha_autorizacion")
  validacionMunicipal Boolean           @default(false) @map("validacion_municipal")
  validacionEstatal   Boolean           @default(false) @map("validacion_estatal")
  observaciones       String            @default("")
  obraId              String            @map("obra_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("estimaciones")
}

model Documento {
  id          String             @id @default(uuid()) @db.Uuid
  categoria   CategoriaDocumento
  nombre      String
  tipo        String             @default("pdf")
  estatus     EstadoDocumento    @default(no_cargado)
  fechaCarga  String?            @map("fecha_carga")
  responsable String?
  archivo     String?
  tamanoBytes Int?               @map("tamano_bytes")
  obraId      String             @map("obra_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("documentos")
}

model Observacion {
  id              String             @id @default(uuid()) @db.Uuid
  usuarioEmisor   String             @map("usuario_emisor")
  fecha           String
  tipo            String
  descripcion     String
  severidad       String             @default("media")
  responsable     String?
  fechaCompromiso String?            @map("fecha_compromiso")
  estatus         EstatusObservacion @default(abierta)
  respuestasJson  Json               @default("[]") @map("respuestas_json")
  obraId          String             @map("obra_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("observaciones")
}

model Alerta {
  id               String   @id @default(uuid()) @db.Uuid
  municipio        String
  municipioId      String?  @map("municipio_id") @db.Uuid
  titulo           String
  descripcion      String
  tipo             String
  severidad        String   @default("media")
  fechaGeneracion  String   @map("fecha_generacion")
  atendida         Boolean  @default(false)
  accionTomada     String?  @map("accion_tomada")
  obraId           String?  @map("obra_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  obra      Obra?      @relation(fields: [obraId], references: [id], onDelete: SetNull)
  municipioRef Municipio? @relation(fields: [municipioId], references: [id])

  @@index([atendida, severidad])
  @@index([municipioId])
  @@map("alertas")
}

model Cofinanciamiento {
  id          String   @id @default(uuid()) @db.Uuid
  obraId      String   @map("obra_id") @db.Uuid
  fuente      String
  monto       Decimal  @db.Decimal(14, 2)
  porcentaje  Decimal  @default(0) @db.Decimal(5, 2)
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("cofinanciamientos")
}

model AnexoEjecucion {
  id                String   @id @default(uuid()) @db.Uuid
  numero            String   @unique
  ejercicioFiscal   Int      @map("ejercicio_fiscal")
  entidadFederativa String   @map("entidad_federativa")
  montoFederal      Decimal  @map("monto_federal") @db.Decimal(14, 2)
  montoEstatal      Decimal  @map("monto_estatal") @db.Decimal(14, 2)
  fechaFirma        String?  @map("fecha_firma")
  fechaVigenciaFin  String?  @map("fecha_vigencia_fin")
  estatus           String   @default("vigente")
  archivoUrl        String?  @map("archivo_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  anexosTecnicos  AnexoTecnico[]
  cierresEjercicio CierreEjercicio[]

  @@index([ejercicioFiscal])
  @@map("anexos_ejecucion")
}

model AnexoTecnico {
  id                  String   @id @default(uuid()) @db.Uuid
  anexoEjecucionId    String   @map("anexo_ejecucion_id") @db.Uuid
  organismoOperadorId String?  @map("organismo_operador_id") @db.Uuid
  ejercicioFiscal     Int      @map("ejercicio_fiscal")
  tipoLocalidad       String   @map("tipo_localidad")
  estatus             String   @default("vigente")
  archivoUrl          String?  @map("archivo_url")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  anexoEjecucion    AnexoEjecucion     @relation(fields: [anexoEjecucionId], references: [id])
  organismoOperador OrganismoOperador? @relation(fields: [organismoOperadorId], references: [id])
  obras             Obra[]

  @@index([anexoEjecucionId])
  @@index([organismoOperadorId])
  @@map("anexos_tecnicos")
}

model AvanceTrimestral {
  id                    String        @id @default(uuid()) @db.Uuid
  obraId                String        @map("obra_id") @db.Uuid
  ejercicioFiscal       Int           @map("ejercicio_fiscal")
  trimestre             Int
  avanceFisicoAnterior  Decimal       @default(0) @map("avance_fisico_anterior") @db.Decimal(5, 2)
  avanceFisicoTrimestre Decimal       @default(0) @map("avance_fisico_trimestre") @db.Decimal(5, 2)
  avanceFisicoAcumulado Decimal       @default(0) @map("avance_fisico_acumulado") @db.Decimal(5, 2)
  avanceFinAnterior     Decimal       @default(0) @map("avance_fin_anterior") @db.Decimal(14, 2)
  avanceFinTrimestre    Decimal       @default(0) @map("avance_fin_trimestre") @db.Decimal(14, 2)
  avanceFinAcumulado    Decimal       @default(0) @map("avance_fin_acumulado") @db.Decimal(14, 2)
  fechaEntrega          String?       @map("fecha_entrega")
  estatus               EstatusAvance @default(pendiente)
  observaciones         String        @default("")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([obraId, ejercicioFiscal, trimestre])
  @@index([obraId])
  @@map("avances_trimestrales")
}

model CierreEjercicio {
  id                    String   @id @default(uuid()) @db.Uuid
  anexoEjecucionId      String   @map("anexo_ejecucion_id") @db.Uuid
  ejercicioFiscal       Int      @map("ejercicio_fiscal")
  tipoApoyo             String   @map("tipo_apoyo")
  montoTransferido      Decimal  @map("monto_transferido") @db.Decimal(14, 2)
  montoReintegradoEj    Decimal  @default(0) @map("monto_reintegrado_ejercicio") @db.Decimal(14, 2)
  montoModificado31dic  Decimal  @default(0) @map("monto_modificado_31dic") @db.Decimal(14, 2)
  montoInformeFinal     Decimal  @default(0) @map("monto_informe_final") @db.Decimal(14, 2)
  montoReintegrado15ene Decimal  @default(0) @map("monto_reintegrado_15ene") @db.Decimal(14, 2)
  montoPorReintegrar    Decimal  @default(0) @map("monto_por_reintegrar") @db.Decimal(14, 2)
  fechaCierre           String?  @map("fecha_cierre")
  estatus               String   @default("pendiente")
  archivoUrl            String?  @map("archivo_url")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  anexoEjecucion AnexoEjecucion @relation(fields: [anexoEjecucionId], references: [id])

  @@unique([anexoEjecucionId, tipoApoyo])
  @@index([anexoEjecucionId])
  @@map("cierres_ejercicio")
}

model SolicitudPrograma {
  id               String   @id @default(uuid()) @db.Uuid
  programa         String
  ejercicioFiscal  Int      @map("ejercicio_fiscal")
  entidadId        String   @map("entidad_id") @db.Uuid
  municipioId      String   @map("municipio_id") @db.Uuid
  tipoApoyo        String   @map("tipo_apoyo")
  componente       String
  montoSolicitado  Decimal  @map("monto_solicitado") @db.Decimal(14, 2)
  estatus          String   @default("borrador")
  obraResultanteId String?  @map("obra_resultante_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  entidad          EntidadFederativa @relation(fields: [entidadId], references: [id])
  municipio        Municipio         @relation(fields: [municipioId], references: [id])
  obraResultante   Obra?             @relation("SolicitudObraResultante", fields: [obraResultanteId], references: [id])

  @@index([entidadId])
  @@index([municipioId])
  @@index([obraResultanteId])
  @@index([estatus])
  @@map("solicitudes_programa")
}
