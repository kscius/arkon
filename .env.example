# Database
POSTGRES_USER=arkon
POSTGRES_PASSWORD=arkon_password
POSTGRES_DB=arkon_db
# Dev local (sin Docker): localhost:5432
DATABASE_URL=postgresql://arkon:arkon_password@localhost:5432/arkon_db
# Docker Compose: Postgres expuesto en host en 5433 (evita conflicto con otros stacks)
POSTGRES_PORT=5433

# Puertos publicados en host (Docker Compose)
API_PORT=8000
WEB_PORT=8080

# API
SECRET_KEY=change-me-in-production-use-long-random-string
JWT_EXPIRES_MINUTES=480
PORT=8000
# Docker: incluir http://localhost:8080; dev Vite: http://localhost:5173
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
ALLOW_PUBLIC_REGISTER=true
OPENAI_API_KEY=
# Optional: override default gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Web (dev local con Vite)
VITE_API_URL=http://localhost:8000/api
# Upstream interno para nginx en el contenedor web (Compose: api:8000)
# En EasyPanel con servicios separados, usar el hostname interno del servicio API
API_UPSTREAM=api:8000
# Tenant white-label: arkon | conagua (rama conagua usa conagua)
TENANT_ID=conagua
VITE_TENANT=conagua
